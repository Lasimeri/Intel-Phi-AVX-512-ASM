# x86dec.inc: the decoder's layouts (decode.S): the decoded-instruction
# block it fills, the length table's and the entry table's fields
# (x86tab.inc, generated by tools/gen-x86-tables.c, which writes the C
# mirror x86tab.h for tools/decode-check.c). See x86dec.md.

# The decoded instruction (struct insn), IN_BYTES bytes, 8-aligned.
	.set IN_LEN, 0				# u8: bytes, 0 if the decode failed
	.set IN_ENC, 1				# u8: 0 legacy, 1 VEX, 2 EVEX
	.set IN_MAP, 2				# u8: 0 one-byte, 1 0F, 2 0F38, 3 0F3A
	.set IN_PP, 3				# u8: the prefix the entry was matched under (0 none, 1 66, 2 F3, 3 F2)
	.set IN_OP, 4				# u8: the opcode byte
	.set IN_PFX, 5				# u8: P_* bits of the legacy prefixes seen
	.set IN_REX, 6				# u8: legacy: the REX byte (0 if none); VEX/EVEX: X_* bits
	.set IN_W, 7				# u8: REX.W or VEX/EVEX.W
	.set IN_L, 8				# u8: VEX L or EVEX L'L (0 128, 1 256, 2 512)
	.set IN_MODRM, 9			# u8: the ModRM byte (0 if none: see IN_HAS)
	.set IN_HAS, 10				# u8: H_* bits
	.set IN_MOD, 11				# u8: ModRM.mod
	.set IN_REG, 12				# u8: ModRM.reg with R and R' (0 to 31)
	.set IN_RM, 13				# u8: ModRM.rm with B (and X in an EVEX register form)
	.set IN_BASE, 14			# u8: the base register with B, 0xff none (absolute or rip-relative)
	.set IN_INDEX, 15			# u8: the index register with X (and V' for a VSIB), 0xff none
	.set IN_SCALE, 16			# u8: the SIB scale field (shift count)
	.set IN_VVVV, 17			# u8: VEX/EVEX vvvv with V', not inverted (0 to 31)
	.set IN_AAA, 18				# u8: EVEX mask register
	.set IN_Z, 19				# u8: EVEX.z
	.set IN_B, 20				# u8: EVEX.b
	.set IN_FLOW, 21			# u8: FL_*
	.set IN_IMM_OFF, 22			# u8: offset of the immediate in the instruction
	.set IN_IMM_SZ, 23			# u8: its bytes (0 none; 3 = imm16 then imm8, ENTER)
	.set IN_DISP_OFF, 24			# u8: offset of the displacement
	.set IN_DISP_SZ, 25			# u8: 1 or 4 (0 none)
	.set IN_OP_OFF, 26			# u8: offset of the opcode byte (after prefixes and the VEX/EVEX payload)
	.set IN_MODRM_OFF, 27			# u8
	.set IN_OPSIZE, 28			# u8: the legacy operand size in bytes (2, 4, 8)
	.set IN_IMM2, 29			# u8: ENTER's second immediate
	.set IN_N, 30				# u8: the disp8 scale applied (EVEX), else 1
	.set IN_ENTRY, 32			# u32: index into x86_ent, 0xffffffff none
	.set IN_DISP, 40			# i64: the displacement, sign-extended, disp8*N applied
	.set IN_IMM, 48				# u64: the immediate, zero-extended by its size (the entry's operand kind says if it is signed)
	.set IN_TARGET, 56			# u64: a relative branch's target
	.set IN_NEXT, 64			# u64: the next instruction's address
	.set IN_ENTRYP, 72			# u64: pointer to the entry, 0 none
	.set IN_BYTES, 96

# IN_HAS bits.
	.set H_MODRM, 1
	.set H_SIB, 2
	.set H_DISP, 4
	.set H_IMM, 8
	.set H_RIPREL, 16
	.set H_MEM, 32				# a memory operand (ModRM.mod not 3)
	.set H_ENTRY, 64
	.set H_VSIB, 128
# IN_PFX bits.
	.set P_66, 1
	.set P_F2, 2
	.set P_F3, 4
	.set P_LOCK, 8
	.set P_67, 16
	.set P_FS, 32
	.set P_GS, 64
	.set P_SEG, 128				# es, cs, ss, ds
# IN_REX bits for VEX/EVEX (the extension bits as the prefix gave them, not inverted).
	.set X_B, 1
	.set X_X, 2
	.set X_R, 4
	.set X_W, 8
	.set X_RP, 16				# EVEX R'
	.set X_VP, 32				# EVEX V'
# Flow classes.
	.set FL_NEXT, 0
	.set FL_JCC, 1
	.set FL_JMP, 2
	.set FL_CALL, 3
	.set FL_RET, 4
	.set FL_JMPI, 5
	.set FL_CALLI, 6
	.set FL_TRAP, 7				# syscall, int, int3, hlt, ud2
	.set FL_LOOP, 8				# loop, jrcxz (rel8, conditional)
	.set FL_FAR, 9				# far forms, iret, sysret: never translated
# The length table (x86_len_tab: 8 maps of 256 entries of 4 bytes) and its
# group subtables (x86_grp_tab: 8 entries of 4 bytes each).
	.set LT_FLAGS, 0
	.set LT_IMM, 1				# low nibble: immediate bytes at operand size 32, high: at 16; a group entry: the subtable index
	.set LT_IMM64, 2			# low nibble: at 64; LI_REL, LI_MOFFS above
	.set LT_FLOW, 3
	.set LT_MODRM, 1
	.set LT_GROUP, 2
	.set LT_D64, 4				# the operand size defaults to 64 (push, call, jmp, ret, ...)
	.set LT_INVALID, 8
	.set LT_PFX, 16
	.set LT_ESC, 32
	.set LT_F64, 64				# the operand size is 64 whatever the prefix
	.set LT_X87, 128
	.set LI_REL, 0x10
	.set LI_MOFFS, 0x20
# An entry (x86_ent, EN_BYTES each).
	.set EN_W, 0				# 0, 1, 2 any
	.set EN_L, 1				# 0, 1, 2, 3 any
	.set EN_GRP, 2				# ModRM.reg or 255
	.set EN_RMFIX, 3			# ModRM.rm fixed by a two-byte opcode, or 255
	.set EN_MODREQ, 4			# 0 any, 1 register form, 2 memory form
	.set EN_N, 5				# disp8 scale without broadcast
	.set EN_NB, 6				# with broadcast (0: cannot)
	.set EN_FLAGS, 7
	.set EN_OPSIZE, 8			# 0 any, 2, 4, 8 (legacy)
	.set EN_NOPS, 9
	.set EN_OPS, 10				# 5 bytes: operand kinds, iced's numbering (x86tab.h)
	.set EN_X, 15				# bits 0-1: the address size (0 any, 1 32-bit, 2 64-bit); EX_D64, EX_F64
	.set EN_CODE, 16			# u16: index into x86_code_off / x86_code_str
	.set EN_MNEM, 18			# u16: index into x86_mnem_off / x86_mnem_str
	.set EN_BYTES, 24
	.set EF_B, 1
	.set EF_Z, 2
	.set EF_K, 4
	.set EF_KREQ, 8
	.set EF_RC, 16
	.set EF_SAE, 32
	.set EF_LOCK, 64
	.set EF_LAST, 128
	.set EX_ASIZE, 3
	.set EX_D64, 4				# the operand size defaults to 64 for this entry
	.set EX_F64, 8				# and ignores a 66 prefix
# Operand kinds the decoder itself looks at (the rest are the translator's).
	.set OK_mem_vsib32x, 7
	.set OK_mem_vsib64z, 12
